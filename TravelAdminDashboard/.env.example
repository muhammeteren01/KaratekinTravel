# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# API adresi. Boş bırakılırsa http://localhost:5076 kullanılır.
VITE_API_BASE_URL=http://localhost:5076

# Yalnızca GoogleMap bileşenini kullanacaksanız gerekli.
# Tanımlı değilse harita yerine bilgilendirme kutusu gösterilir.
# Rota oluşturma ekranı OpenStreetMap kullanıyor, anahtar istemiyor.
# VITE_GOOGLE_MAPS_API_KEY=
