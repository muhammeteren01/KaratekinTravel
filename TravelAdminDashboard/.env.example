# Gerçek API adresi (demo modu kapalıyken kullanılır)
VITE_API_BASE_URL=http://localhost:5076

# Demo modu: true yapıldığında backend ve veritabanı olmadan çalışır.
# Tüm API çağrıları tarayıcı içindeki sahte sunucuya gider, veriler
# localStorage'da saklanır. Giriş: demo@karatekin.test / demo1234
VITE_DEMO_MODE=false

