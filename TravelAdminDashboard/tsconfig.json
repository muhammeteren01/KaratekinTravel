{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,

    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,

    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
